{
  "expo": {
    "name": "truthify",
    "slug": "truthify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/TFlogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAFA"
      },
      "edgeToEdgeEnabled": true
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EC"
        }
      ],
      "expo-font"
    ]
  }
}
